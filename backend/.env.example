# ─────────────────────────────────────────────────────────────────────────────
# FreightIQ — .env Template
# Copy this file to `.env` and fill in your API keys.
# The server will start without these keys, but the NLQ chat endpoint
# (/api/v1/chat/query) will return HTTP 503 until OPENAI_API_KEY is set.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (REQUIRED for NLQ) ──────────────────────────────────────────────
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.1

# ── Vector Store Backend ───────────────────────────────────────────────────
# Options: "faiss" (default, local, zero-config) or "pinecone" (cloud)
VECTOR_STORE_BACKEND=faiss

# ── Pinecone (only needed if VECTOR_STORE_BACKEND=pinecone) ────────────────
PINECONE_API_KEY=your-key-here
PINECONE_INDEX_NAME=freightiq-knowledge
PINECONE_ENVIRONMENT=us-east-1

# ── Retrieval Settings ─────────────────────────────────────────────────────
RETRIEVER_TOP_K=4
RETRIEVER_SEARCH_TYPE=mmr

# ── Agent Settings ─────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=8
AGENT_VERBOSE=false
